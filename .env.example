# ------------------------------------------------------------------- core --

DATABASE_URL=postgres://corsair:corsair@localhost:55433/corsair
DB_POOL_SIZE=10
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
PUBLIC_URL=http://localhost:3000

# The interface the HTTP tier binds. 0.0.0.0 is the right default for a
# container — one that binds loopback is one nothing can reach. If you run a
# reverse proxy on the same box, set this to 127.0.0.1: the panel, the webmail,
# and JMAP have no business being reachable except through the proxy that
# terminates TLS for them, and a firewall rule is a weaker promise than never
# having listened.
HOST=0.0.0.0

# ------------------------------------------------------------------- mail --

# The hostname this server calls itself in SMTP EHLO and Received headers. It
# must resolve, and its PTR record must point back here, or the large providers
# will reject everything you send.
CORSAIR_HOSTNAME=mail.corsair.local

# What the DNS Setup screen tells customers to point their records at. These are
# the public names of *this* installation, not of the customer's domain.
MAIL_MX_HOST=mx1.corsair.local
MAIL_SMTP_HOST=smtp.corsair.local
MAIL_IMAP_HOST=imap.corsair.local
MAIL_POP_HOST=pop.corsair.local
MAIL_SPF_HOST=spf.corsair.local
MAIL_AUTOCONFIG_HOST=autoconfig.corsair.local
MAIL_AUTODISCOVER_HOST=autodiscover.corsair.local

# DKIM keys are generated per domain. Customers publish a CNAME per selector
# pointing at <selector-host>, and this server answers the lookup. Three
# selectors let a key be rotated without a gap in signing.
MAIL_DKIM_HOSTS=dkim-1.corsair.local,dkim-2.corsair.local,dkim-3.corsair.local

# --------------------------------------------------------------- listeners --

# Ports below 1024 need either root or CAP_NET_BIND_SERVICE. The defaults here
# are the unprivileged development ports; production uses 25/465/587/993/995.
SMTP_MX_PORT=2525
SMTP_SUBMISSION_PORT=2587
SMTP_SUBMISSION_TLS_PORT=2465
# Where the two plaintext-capable listeners bind. Set to 127.0.0.1 when the
# STARTTLS terminator (engine/) holds 25 and 587 in front of them. Submission
# on 465 is unaffected — it has no plaintext phase.
SMTP_BIND=0.0.0.0
# True when the terminator in engine/ provides STARTTLS for the ports above.
# Changes nothing this process does — changes what the server tells the world,
# so autoconfig and the MTA-STS policy stop saying STARTTLS is unavailable.
SMTP_STARTTLS_FRONTED=false
# The ports clients are told to use. Defaults to the listening ports, which is
# right until something in front holds the public ones.
SMTP_PUBLIC_SUBMISSION_PORT=
SMTP_PUBLIC_SUBMISSION_TLS_PORT=
# Peers allowed to say which address a session is really from, via XCLIENT.
# Empty means the command is refused outright. Only the terminator belongs here.
SMTP_TRUSTED_PROXIES=
IMAP_PORT=2143
IMAP_TLS_PORT=2993
POP3_PORT=2110
POP3_TLS_PORT=2995

SMTP_ENABLED=true
IMAP_ENABLED=true
POP3_ENABLED=true

# PEM files used by the implicit-TLS listeners and by STARTTLS. Leave empty to
# run plaintext-only, which is fine locally and unacceptable anywhere else.
TLS_CERT_PATH=
TLS_KEY_PATH=

# -------------------------------------------------------------- delivery --

# direct  — look up the recipient's MX and talk to it (needs port 25 outbound)
# relay   — hand everything to an upstream smarthost
# console — print to stdout, deliver nothing (default for local dev)
DELIVERY_TRANSPORT=console
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASS=
SMTP_RELAY_SECURE=starttls

# --------------------------------------------------------------- storage --

# Message bodies live in an S3-compatible bucket (DigitalOcean Spaces) and only
# their headers and flags live in Postgres. Leave the bucket empty to keep
# bodies inline in Postgres, which is simpler but does not scale.
STORAGE_BUCKET=
STORAGE_REGION=nyc3
STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PREFIX=corsair

# ---------------------------------------------------------------- workers --

WORKER_CONCURRENCY=8
WORKER_POLL_MS=1000

# ---------------------------------------------------------------- payments --

# Optional. Without these Corsair runs unmetered: plans still gate features and
# an operator can record payment methods by hand, but nothing is charged.
# Card details never reach this server — the customer enters them on the
# provider's own hosted page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- webhooks --

# Webhook endpoints on private or loopback addresses are refused by default,
# because the customer supplies the URL and this server fetches it. Turn this on
# only if your consumers are on the same private network as this server.
WEBHOOK_ALLOW_PRIVATE=false

# ----------------------------------------------------------------- limits --

RATE_LIMIT_PER_SECOND=10
MAX_MESSAGE_BYTES=52428800

# ------------------------------------------------------------------ setup --

# Set to open to let anyone sign up, closed to allow only the first account.
SIGNUPS=open
