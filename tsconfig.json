{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@atlas/admin": [
        "./node_modules/atlas/web/packages/admin/index.ts"
      ],
      "@atlas/ai": [
        "./node_modules/atlas/web/packages/ai/index.ts"
      ],
      "@atlas/auth": [
        "./node_modules/atlas/web/packages/auth/index.ts"
      ],
      "@atlas/auth/social": [
        "./node_modules/atlas/web/packages/auth/social/index.ts"
      ],
      "@atlas/cache": [
        "./node_modules/atlas/web/packages/cache/index.ts"
      ],
      "@atlas/cli": [
        "./node_modules/atlas/web/packages/cli/index.ts"
      ],
      "@atlas/config": [
        "./node_modules/atlas/web/packages/config/index.ts"
      ],
      "@atlas/db": [
        "./node_modules/atlas/web/packages/db/index.ts"
      ],
      "@atlas/edge": [
        "./node_modules/atlas/web/packages/edge/index.ts"
      ],
      "@atlas/email": [
        "./node_modules/atlas/web/packages/email/index.ts"
      ],
      "@atlas/mcp": [
        "./node_modules/atlas/web/packages/mcp/index.ts"
      ],
      "@atlas/migrate": [
        "./node_modules/atlas/web/packages/migrate/index.ts"
      ],
      "@atlas/oauth": [
        "./node_modules/atlas/web/packages/oauth/index.ts"
      ],
      "@atlas/request": [
        "./node_modules/atlas/web/packages/request/index.ts"
      ],
      "@atlas/request/providers": [
        "./node_modules/atlas/web/packages/request/providers/index.ts"
      ],
      "@atlas/security": [
        "./node_modules/atlas/web/packages/security/index.ts"
      ],
      "@atlas/server": [
        "./node_modules/atlas/web/packages/server/index.ts"
      ],
      "@atlas/server/sse": [
        "./node_modules/atlas/web/packages/server/sse/index.ts"
      ],
      "@atlas/server/ws": [
        "./node_modules/atlas/web/packages/server/ws/index.ts"
      ],
      "@atlas/share": [
        "./node_modules/atlas/web/packages/share/index.ts"
      ],
      "@atlas/sso": [
        "./node_modules/atlas/web/packages/sso/index.ts"
      ],
      "@atlas/storage": [
        "./node_modules/atlas/web/packages/storage/index.ts"
      ],
      "@atlas/ui": [
        "./node_modules/atlas/web/packages/ui/index.ts"
      ],
      "@atlas/ui/*": [
        "./node_modules/atlas/web/packages/ui/*/index.tsx"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
