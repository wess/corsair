{
  "name": "corsair",
  "version": "0.3.6",
  "description": "Open source email hosting. Mailboxes on your own domains — SMTP, IMAP, POP3, and a control panel.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wess/corsair.git"
  },
  "scripts": {
    "dev": "bun src/dev.ts",
    "start": "bun src/start.ts",
    "api": "bun --hot src/server.ts",
    "migrate": "bun scripts/migrate.ts up",
    "migrate:status": "bun scripts/migrate.ts status",
    "migrate:down": "bun scripts/migrate.ts down",
    "migrate:diff": "bun scripts/migrate.ts diff",
    "seed": "bun scripts/seed.ts",
    "dkim": "bun scripts/dkim.ts",
    "db:up": "docker compose -f docker/compose.yml up -d",
    "db:down": "docker compose -f docker/compose.yml down",
    "test": "WEBHOOK_ALLOW_PRIVATE=true bun test --concurrency=1 tests/ && STRIPE_SECRET_KEY=sk_test_dummy STRIPE_WEBHOOK_SECRET=whsec_dummy bun test tests/billingstripe.test.ts",
    "test:smoke": "bun tests/smoke.ts",
    "test:resend": "bun tests/resend.ts",
    "test:webmail": "bun tests/webmail.ts",
    "test:jmap": "bun tests/jmap.ts",
    "test:mailflow": "bun tests/mailflow.ts",
    "site:build": "bun site/build.ts",
    "site:check": "bun site/build.ts && bun site/check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/ scripts/ site/ tests/",
    "format": "biome format src/ scripts/ site/ tests/",
    "check": "biome check src/ scripts/ site/ tests/",
    "lint:fix": "biome lint --write src/ scripts/ site/ tests/",
    "format:fix": "biome format --write src/ scripts/ site/ tests/",
    "tidy": "bun run format:fix && bun run lint:fix",
    "test:starttls": "bun tests/starttls.ts",
    "engine:build": "cargo build --release --manifest-path engine/Cargo.toml",
    "engine:test": "cargo test --manifest-path engine/Cargo.toml",
    "test:mxfront": "bun run engine:build && bun tests/mxfront.ts",
    "test:dns": "bun tests/dns.ts",
    "test:starttls:server": "bun tests/serverstarttls.ts",
    "test:admins": "bun tests/admins.ts",
    "check:atlas": "bunx --package https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-cli-0.4.9.tgz atlas check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "@wess/atlas": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-0.4.9.tgz",
    "@wess/atlas-auth": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-auth-0.4.9.tgz",
    "@wess/atlas-config": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-config-0.4.9.tgz",
    "@wess/atlas-db": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-db-0.4.9.tgz",
    "@wess/atlas-migrate": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-migrate-0.4.9.tgz",
    "@wess/atlas-security": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-security-0.4.9.tgz",
    "@wess/atlas-server": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-server-0.4.9.tgz",
    "@wess/atlas-storage": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-storage-0.4.9.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "resend": "6.34.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
